dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / Secrets
.env

# Data (runtime, uploads, cache)
data/uploads/*
data/fipe_cache/*
data/appraisal_feedback.csv
!data/uploads/.gitkeep
!data/fipe_cache/.gitkeep
.cache/

# Arquivos de dados na raiz (contêm dados de clientes — nunca commitar)
# Intencionalmente: arquivos .xlsx ficam fora do git por padrão.
# Em produção, usar SALES_HISTORY_URL e APPRAISAL_HISTORY_URL (Google Sheets).
*.xlsx
*.xlsm
*.xls
*.csv
# Exceção: permitir fixtures de teste, que são essenciais e são dados sintéticos
!tests/fixtures/**
!tests/**/*.csv
!tests/**/*.xlsx

# Excel lock files
~$*

# Arquivos de redirecionamento Windows que vazaram
nul

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
htmlcov/
.coverage

# Streamlit
.streamlit/

# Claude
.claude/

